# EyeX Technologies - Production Environment Template
# Copy to .env.production and fill with real secrets before deploying.

APP_NAME=EyeX Technologies
APP_VERSION=1.0.0-rc1
APP_ENVIRONMENT=production
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
CORS_ORIGINS=https://eyex.com,https://www.eyex.com,https://app.eyex.com,https://api.eyex.com,https://auth.eyex.com,https://docs.eyex.com,http://localhost:3000,http://localhost:5173,http://localhost:4173
TRUSTED_HOSTS=eyex.com,www.eyex.com,app.eyex.com,api.eyex.com,auth.eyex.com,docs.eyex.com,eyex-api,localhost
REQUIRE_HTTPS=true
ENABLE_SECURITY_HEADERS=true

# Database
DATABASE_URL=postgresql+asyncpg://eyex:strong_password@postgres:5432/eyex
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Supabase (copy real values from your Supabase project settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Modern Supabase projects sign tokens with ES256/RS256 verified via JWKS.
# Set SUPABASE_JWKS_URL for this (recommended). Only set SUPABASE_JWT_SECRET
# if your project still uses the legacy HS256 shared-secret JWT signing.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2048

# Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
OTLP_ENDPOINT=

# PostgreSQL container
POSTGRES_USER=eyex
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=eyex

# Backup
BACKUP_RETENTION_DAYS=14
