# ══════════════════════════════════════════════════════════════
# πX Enterprise — Production Environment Variables
# Copy to .env.production and fill in real values
# ══════════════════════════════════════════════════════════════

# Application
APP_NAME=πX Technologies
APP_ENVIRONMENT=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE-ME-64-CHARS
APP_VERSION=1.0.0

# PostgreSQL (or Supabase pooler URL)
DATABASE_URL=postgresql+asyncpg://pix:pix_password@postgres:5432/pix
POSTGRES_USER=pix
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=pix

# Redis
REDIS_URL=redis://redis:6379/0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
DEEPSEEK_API_KEY=...
COHERE_API_KEY=...
OLLAMA_BASE_URL=http://localhost:11434

# AI Gateway
AI_MAX_RETRIES=3
AI_RATE_LIMIT_PER_MINUTE=100
AI_COST_BUDGET_DAILY=50.0
AI_ENABLE_STREAMING=true
AI_ENABLE_COST_TRACKING=true

# Frontend (build-time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PYTHON_BACKEND_URL=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS
CORS_ORIGINS=["https://pix.your-domain.com"]

# Agent
AGENT_MAX_CONCURRENT=10
AGENT_DEFAULT_TIMEOUT=60

# Event Bus
EVENT_BUS_TYPE=redis
EVENT_BUS_STREAM_PREFIX=pix:events

# Worker
WORKER_POLL_INTERVAL=5
WORKER_MAX_RETRIES=3
